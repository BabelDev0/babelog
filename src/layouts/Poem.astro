---
import Layout from "./Layout.astro";
const { frontmatter } = Astro.props;
---

<Layout
  title={frontmatter.title}
  lang={frontmatter.lang}
  backUrl="/babelog/poems"
>
  <article class="mx-auto w-full max-w-[65ch]">
    <h1
      class="mt-10 text-center font-flower text-5xl text-balance sm:mt-16 sm:text-6xl"
    >
      {frontmatter.title}
    </h1>

    <div
      class="mt-8 font-flower text-2xl leading-relaxed whitespace-pre-line sm:mt-12 sm:text-3xl"
    >
      <slot />
    </div>

    {
      frontmatter.notes && (
        <div class="mt-12 text-xl text-neutral-700">{frontmatter.notes}</div>
      )
    }
  </article>
</Layout>
