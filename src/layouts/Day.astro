---
import Layout from "./Layout.astro";
const { frontmatter } = Astro.props;
---

<Layout title={frontmatter.title} backUrl="/babelog/days">
  <article class="mx-auto max-w-prose">
    <h1 class="mt-10 text-center font-flower text-4xl sm:mt-16 sm:text-5xl">
      {frontmatter.title}
    </h1>
    <div class="mt-8 font-flower text-2xl leading-relaxed sm:mt-12 lg:text-3xl">
      <slot />
    </div>
  </article>
</Layout>
