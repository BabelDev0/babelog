---
import titleIcon from "@icons/title.svg";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  lang?: string;
  backUrl?: string;
  footer?: boolean;
}

const {
  title,
  description = "Babelog: paintings, poems and days by BabelDev0.",
  lang = "en",
  backUrl = "/babelog",
  footer = true,
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/babelog/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title === "Babelog" ? title : `${title} | Babelog`}</title>
  </head>
  <body class="flex flex-col min-h-screen">
    <main class="flex-grow">
      <a href="/babelog">
        <div class="flex items-center justify-center mt-32 w-full">
          <img
            class="w-40"
            src="/babelog/logo.webp"
            srcset="/babelog/logo.webp 1x, /babelog/logo@2x.webp 2x"
            width="160"
            height="140"
            alt="Babelog logo"
          />
        </div>
        <div class="flex items-center justify-center w-full">
          <img class="w-80" src={titleIcon.src} alt="Babelog" />
        </div>
      </a>
      <slot />
      {
        backUrl && (
          <a href={backUrl} class="flex items-center justify-center mt-16">
            <h1 class="text-4xl">🔙</h1>
          </a>
        )
      }
    </main>
    <!-- Footer section -->
    {
      footer && (
        <footer class="text-sm mx-10 mt-20 mb-3">
          <div class="flex justify-center items-center">
            <p class="mr-1">
              We use analytics to gather data about how our website is used.{" "}
              <a class="text-blue-400 font-bold" href="/babelog/privacy-policy">
                Privacy Policy
              </a>
              .
            </p>
          </div>
        </footer>
      )
    }
    {
      import.meta.env.PROD && (
        <>
          <script
            is:inline
            async
            src="https://scripts.simpleanalyticscdn.com/latest.js"
          />
          <noscript>
            <img
              src="https://queue.simpleanalyticscdn.com/noscript.gif"
              alt=""
              referrerpolicy="no-referrer-when-downgrade"
            />
          </noscript>
        </>
      )
    }
  </body>

</html>
