---
import Layout from "../layouts/Layout.astro";
import paintings from "../data/paintingsData.ts";
import Preview from "../components/Preview.astro";
---

<Layout title="Paintings">
  <h1 class="sr-only">Paintings</h1>
  <div
    class="mx-auto mt-10 grid max-w-6xl grid-cols-1 gap-10 sm:mt-16 sm:grid-cols-2 lg:grid-cols-3"
  >
    {
      paintings.map((painting, i) => (
        <Preview image={painting.image} lazyLoad={i > 1} title={painting.title} />
      ))
    }
  </div>
</Layout>
