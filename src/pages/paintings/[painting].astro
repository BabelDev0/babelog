---
import Layout from "../../layouts/Layout.astro";
import paintings from "../../data/paintingsData";

export async function getStaticPaths() {
  // Generate paths based on the paintings array
  return paintings.map((painting) => ({
    params: { painting: painting.title },
  }));
}

const { painting } = Astro.params;
const currentpainting = paintings.find((o) => o.title === painting);
---

<Layout
  title={currentpainting?.title ?? "painting"}
  backUrl="/babelog/paintings"
>
  <div class="flex flex-col items-center justify-center w-full mt-36">
    <div class="border-4 border-black mx-1">
      <img
        class="sm:w-svh md:h-svh lg:h-svh"
        src={currentpainting?.src}
        alt={currentpainting?.title}
      />
    </div>
    <h1 class="text-4xl font-flower font-bold mt-10">
      {currentpainting?.title}
    </h1>
  </div>
</Layout>
