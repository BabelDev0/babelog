---
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import paintings from "../../data/paintingsData";

export async function getStaticPaths() {
  // Generate paths based on the paintings array
  return paintings.map((painting) => ({
    params: { painting: painting.title },
  }));
}

const { painting } = Astro.params;
const currentpainting = paintings.find((o) => o.title === painting);
---

<Layout
  title={currentpainting?.title ?? "painting"}
  backUrl="/babelog/paintings"
>
  {
    currentpainting && (
      <figure class="mt-10 flex flex-col items-center sm:mt-16">
        <Image
          class="h-auto max-h-[80svh] w-auto max-w-full border-4 border-black object-contain"
          src={currentpainting.image}
          widths={[480, 768, 1080, 1440]}
          sizes="(min-width: 768px) 60vw, calc(100vw - 2rem)"
          loading="eager"
          fetchpriority="high"
          alt={currentpainting.title}
        />
        <figcaption>
          <h1 class="mt-6 text-center font-flower text-4xl font-bold">
            {currentpainting.title}
          </h1>
        </figcaption>
      </figure>
    )
  }
</Layout>
