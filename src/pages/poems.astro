---
import Layout from "../layouts/Layout.astro";
import poems from "../data/poemsData";
---

<Layout title="Poems">
  <h1 class="sr-only">Poems</h1>
  <ul class="mx-auto mt-10 grid max-w-3xl grid-cols-1 gap-5 sm:mt-16 sm:gap-8 lg:grid-cols-2">
    {
      poems.map((poem) => (
        <li>
          <a
            href={poem.path}
            class="flex min-h-24 items-center justify-center border-4 border-black p-6 text-center font-flower text-3xl transition duration-300 motion-safe:hover:scale-105 sm:p-10"
          >
            {poem.title}
          </a>
        </li>
      ))
    }
  </ul>
</Layout>
