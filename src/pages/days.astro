---
import Layout from "../layouts/Layout.astro";
import days from "../data/daysData";

const path = "/babelog/days/";
---

<Layout title="Days">
  <div class="mx-auto mt-10 flex max-w-5xl flex-col items-center sm:mt-16">
    <h1 class="sr-only">Days</h1>
    <div class="max-w-prose">
      <p class="font-flower text-xl leading-relaxed sm:text-2xl">
        This began as a 30-day consistency experiment, where I chose a phrase
        each day to reflect on and build my thoughts around. Some of the phrases
        include the word <u>God</u>, as I found passages from the Bible or other
        sacred texts to be helpful during this process. However, I replaced the
        word <u>God</u> with attributes like <u>Love</u>, <u>Belief</u>, etc.
        depending on the context of the phrase. The reason is that I haven’t yet
        formed a stable concept of God within myself. I’m certain it differs
        from the portrayal in the Old Testament, and less so from that in the
        Gospels, but I’m still unsure. Therefore, I preferred to leave the term
        out for now.
      </p>
    </div>

    <ul
      class="mt-10 grid w-full grid-cols-2 gap-3 text-xl sm:grid-cols-3 sm:gap-6 sm:text-2xl lg:grid-cols-5 lg:text-3xl"
    >
      {
        days.map((day) => (
          <li>
            <a
              href={path + day}
              class="flex min-h-16 items-center justify-center border-2 border-black p-4 font-flower lg:p-8"
            >
              {day}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Layout>
