---
interface Props {
  label: string;
  url: string;
}

const { label, url } = Astro.props;
---

<a
  href={url}
  class="flex h-20 w-full items-center justify-center rounded bg-black px-4 font-flower text-4xl font-bold text-white transition duration-300 motion-safe:hover:scale-105 sm:h-24 sm:w-60 sm:text-5xl"
>
  {label}
</a>
