---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

export interface Props {
  image: ImageMetadata;
  lazyLoad: boolean;
  title: string;
}

const { image, lazyLoad, title } = Astro.props;
---

<a
  href={`/babelog/paintings/${title}`}
  class="group flex flex-col items-center"
>
  <Image
    class="h-auto w-full max-w-sm border-4 border-black transition duration-300 motion-safe:group-hover:scale-105"
    src={image}
    widths={[320, 480, 640, 768]}
    sizes="(min-width: 1024px) 384px, (min-width: 640px) 45vw, calc(100vw - 2rem)"
    loading={lazyLoad ? "lazy" : "eager"}
    fetchpriority={lazyLoad ? "auto" : "high"}
    alt={title}
  />
  <h2 class="mt-3 font-flower text-2xl font-bold">{title}</h2>
</a>
